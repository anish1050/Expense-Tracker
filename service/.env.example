PORT=3002
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DBNAME=spent
JWT_SECRET=replace-with-64-hex-chars
# The WEB client id from Google Cloud console, not the Android one: the app
# requests ID tokens with that id as the audience (GOOGLE_WEB_CLIENT_ID in
# android/app/build.gradle.kts) and this service verifies `aud` against it.
GOOGLE_CLIENT_ID=replace-with-your-web-oauth-client-id.apps.googleusercontent.com
