{
  "version": 1,
  "notification_packages": [
    "com.google.android.apps.nbu.paisa.user",
    "com.phonepe.app",
    "net.one97.paytm"
  ],
  "sms_sender_patterns": [
    "^[A-Z]{2}-HDFCBK(-S)?$",
    "^[A-Z]{2}-SBIUPI(-S)?$",
    "^[A-Z]{2}-ICICIB(-S)?$"
  ],
  "rules": [
    {
      "id": "gpay-paid-notification",
      "source": "notification",
      "match": "^(?:₹|Rs\\.?)\\s?(?<amount>[\\d,]+(?:\\.\\d{1,2})?) paid to (?<merchant>.+?)\\s*$",
      "direction": "debit",
      "confidence": 0.95
    },
    {
      "id": "gpay-received-notification",
      "source": "notification",
      "match": "^(?:₹|Rs\\.?)\\s?(?<amount>[\\d,]+(?:\\.\\d{1,2})?) received from (?<merchant>.+?)\\s*$",
      "direction": "credit",
      "confidence": 0.95
    },
    {
      "id": "phonepe-paid-notification",
      "source": "notification",
      "match": "(?i)paid (?:₹|Rs\\.?)\\s?(?<amount>[\\d,]+(?:\\.\\d{1,2})?) to (?<merchant>.+?)(?:\\.|$)",
      "direction": "debit",
      "confidence": 0.9
    },
    {
      "id": "hdfc-upi-debit-sms",
      "source": "sms",
      "match": "(?i)Rs\\.?\\s?(?<amount>[\\d,]+(?:\\.\\d{1,2})?) debited from a/c \\*\\*(?<last4>\\d{4}) on (?<date>\\d{2}-\\d{2}-\\d{2}) to VPA (?<merchant>\\S+) ref (?<ref>\\d+)",
      "direction": "debit",
      "confidence": 0.95
    },
    {
      "id": "hdfc-credit-sms",
      "source": "sms",
      "match": "(?i)Rs\\.?\\s?(?<amount>[\\d,]+(?:\\.\\d{1,2})?) credited to a/c \\*\\*(?<last4>\\d{4}) on (?<date>\\d{2}-\\d{2}-\\d{2}) by (?:NEFT|IMPS|RTGS|UPI) (?<merchant>.+?) ref (?<ref>\\w+)",
      "direction": "credit",
      "confidence": 0.95
    },
    {
      "id": "sbi-upi-debit-sms",
      "source": "sms",
      "match": "(?i)A/C X(?<last4>\\d{4}) debited by (?<amount>[\\d,]+(?:\\.\\d{1,2})?) on date (?<date>\\d{2}\\w{3}\\d{2}) trf to (?<merchant>.+?) Refno (?<ref>\\d+)",
      "direction": "debit",
      "confidence": 0.9
    },
    {
      "id": "gallery-gpay-paid",
      "source": "gallery",
      "match": "(?is)(?:₹|Rs\\.?)\\s?(?<amount>[\\d,]+(?:\\.\\d{1,2})?).{0,80}?(?:paid to|to)\\s+(?<merchant>[A-Za-z][\\w .&'-]{1,40})",
      "direction": "debit",
      "confidence": 0.7
    }
  ]
}
