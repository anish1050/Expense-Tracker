  "rules": [
    {"id": "gpay-paid-notification", "source": "notification", "channel": "upi", "match": "^(?:₹|Rs\\.?)\\s?(?<amount>[\\d,]+(?:\\.\\d{1,2})?) paid to (?<merchant>.+?)\\s*$", "direction": "debit", "confidence": 0.95},
